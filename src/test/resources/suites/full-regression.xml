<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Trimio FULL REGRESSION — every automated test across both surfaces, in the order a release
  should be checked: auth (no accounts needed) → signed-in mobile journeys → the web portal.

    mvn test -DsuiteXmlFile=src/test/resources/suites/full-regression.xml \
             -Ddb.password=… -Dweb.baseUrl=http://localhost:<port> -DretryCount=0

  Everything that needs an environment it cannot find SKIPS with an explanatory message, so a run
  against a partially-provisioned environment still reports honestly instead of failing loudly.

  Full prerequisites:
    - Android emulator booted with the Trimio app installed
    - backend on :3000, Postgres `trimio` on :5432
    - the web portal served (flutter run -d chrome -t lib/main_web.dart)
    - roleAccounts filled in testdata/mobile/test-accounts.json
-->
<suite name="Trimio Full Regression" parallel="false" verbose="1">

    <listeners>
        <listener class-name="org.example.listeners.TestListener"/>
    </listeners>

    <!-- 1. Auth — needs only a fresh app install -->
    <test name="Auth — onboarding">
        <classes>
            <class name="org.example.tests.mobile.OnboardingTest"/>
        </classes>
    </test>
    <test name="Auth — registration &amp; login">
        <classes>
            <class name="org.example.tests.mobile.RegistrationTest"/>
            <class name="org.example.tests.mobile.LoginTest"/>
        </classes>
    </test>
    <test name="Auth — password recovery">
        <classes>
            <class name="org.example.tests.mobile.ForgotPasswordTest"/>
            <class name="org.example.tests.mobile.OtpTest"/>
            <class name="org.example.tests.mobile.ResetPasswordTest"/>
        </classes>
    </test>

    <!--
      2. Signed-in mobile journeys — need seeded role accounts.

      THE AUTH BLOCK ABOVE COSTS THESE TESTS THEIR FIRST SIGN-IN. It spends roughly forty logins,
      registrations and OTP requests, and the backend's auth limiter is per-source and shared, so
      the first journey here meets "Too many attempts. Please wait a few minutes and try again."
      — while the very same credentials still work from curl in the same second.

      Left in this order deliberately: a release should be checked auth-first, and the alternative
      (two invocations) is easy to get wrong. RoleSessionTest.loginAs() absorbs it instead — it
      tells a rate-limit refusal apart from a credential one, waits out the window once
      (-Dauth.rateLimitCooldownSeconds, default 90) and retries. If it still cannot sign in it
      says so in those words, rather than blaming the account.
    -->
    <test name="Client journeys">
        <classes>
            <class name="org.example.tests.mobile.client.ClientNavigationTest"/>
            <class name="org.example.tests.mobile.client.ClientHomeTest"/>
            <class name="org.example.tests.mobile.client.ClientBookingTest"/>
            <class name="org.example.tests.mobile.client.ClientGroupBookingTest"/>
            <class name="org.example.tests.mobile.client.ClientStyleMeNowTest"/>
            <class name="org.example.tests.mobile.client.ClientAppointmentsTest"/>
            <class name="org.example.tests.mobile.client.ClientStoreTest"/>
            <class name="org.example.tests.mobile.client.ClientMembershipTest"/>
            <class name="org.example.tests.mobile.client.ClientProfileTest"/>
            <class name="org.example.tests.mobile.client.ClientReviewTest"/>
        </classes>
    </test>
    <test name="Professional journeys">
        <classes>
            <class name="org.example.tests.mobile.professional.ProfessionalDashboardTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalDutyTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalBookingsTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalClientHubTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalStoreTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalEarningsTest"/>
            <class name="org.example.tests.mobile.professional.ProfessionalPerformanceTest"/>
        </classes>
    </test>
    <test name="Admin console (mobile)">
        <classes>
            <class name="org.example.tests.mobile.admin.AdminConsoleTest"/>
            <class name="org.example.tests.mobile.admin.AdminUsersTest"/>
            <class name="org.example.tests.mobile.admin.AdminProfessionalApprovalTest"/>
            <class name="org.example.tests.mobile.admin.AdminQualityTest"/>
            <class name="org.example.tests.mobile.admin.AdminQueuesTest"/>
        </classes>
    </test>

    <!-- 3. Web portal — needs the Flutter Web build served -->
    <test name="Web portal">
        <classes>
            <class name="org.example.tests.web.WebPortalAccessTest"/>
            <class name="org.example.tests.web.AdminPortalNavigationTest"/>
            <class name="org.example.tests.web.AdminStoreTest"/>
            <class name="org.example.tests.web.VendorPortalTest"/>
            <class name="org.example.tests.web.VendorApplyTest"/>
        </classes>
    </test>

    <!-- 4. API contract — no device, no browser. Runs after the UI suites so a shared-backend
         hiccup is attributed to the right layer, and because these finish in seconds either way. -->
    <test name="API contract">
        <classes>
            <class name="org.example.tests.api.SocialRegistrationTest"/>
            <class name="org.example.tests.api.MembershipApiTest"/>
            <class name="org.example.tests.api.ObjectScopingTest"/>
        </classes>
    </test>

    <!-- 5. Security — the read-only half only. See the note below for what is left out. -->
    <test name="Security — authorization and input handling">
        <classes>
            <class name="org.example.tests.security.AuthenticationEnforcementTest"/>
            <class name="org.example.tests.security.RoleAuthorizationMatrixTest"/>
            <class name="org.example.tests.security.SuperAdminBoundaryTest"/>
            <class name="org.example.tests.security.InjectionAndInputHandlingTest"/>
        </classes>
    </test>

    <!--
      DELIBERATELY ABSENT from this suite, and each for a reason rather than an oversight:

        AccountEnumerationTest, RateLimitAndLockoutTest, TransportAndHeadersTest
            All three consume login attempts against a SHARED, per-source rate limiter, and the
            abuse tests trip it on purpose. A tripped limiter answers 429 to everything after it —
            including this suite's own mobile logins, which then fail for a reason that has nothing
            to do with them. Observed: a brute-force probe locked the seeded client for an hour and
            took the password-reset tests down with it.
            Run them with suites/security-testng.xml, which orders them last.

        OnDemandDispatchTest (suites/paired-testng.xml)
            Needs a SECOND emulator and holds both for the whole class, which would fight this
            suite's per-method driver. It also accepts a live offer, creating a real appointment.

        ClientIndividualBookingPaymentTest (suites/booking-payment.xml)
            Captures a real charge and leaves a real booking. Stripe test mode, but still a write.

        ApiLatencyTest, ApiConcurrencyTest (run with -Dtest=…)
            Timing assertions are meaningless on a machine that is simultaneously driving an
            emulator, which is exactly what this suite is doing.
    -->

</suite>
