<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  The individual booking money path, on its own.

  Kept separate from mobile-regression because it SPENDS MONEY and CREATES A REAL BOOKING: it
  authorises and captures a charge on the client's saved card and leaves an appointment a
  professional is dispatched to. Everything here is Stripe TEST mode against seeded fixtures, but
  it is still a write, so it is opt-in rather than part of the routine sweep.

  Run:
    mvn test -DsuiteXmlFile=src/test/resources/suites/booking-payment.xml \
             -Ddb.password=… -DretryCount=0
-->
<suite name="TrimioBookingPayment" verbose="1">
    <listeners>
        <listener class-name="org.example.listeners.TestListener"/>
    </listeners>

    <test name="ClientIndividualBookingPayment">
        <classes>
            <class name="org.example.tests.mobile.client.ClientIndividualBookingPaymentTest"/>
        </classes>
    </test>
</suite>
